# Copy to .env.local to point the app at a different backend.
#
#   cp .env.example .env.local
#
# Optional. With this unset the app uses the live Render backend at
# https://gloobal-pay.onrender.com, which is the normal case.
#
# Must be an absolute http(s) URL. A relative value (e.g. "/api") is
# ignored on purpose — it would silently turn every call into a
# same-origin request that 404s. See backend/services/api/httpClient.js.
#
# VITE_API_URL=http://localhost:5000

# NEVER put MONGO_URI, database credentials, or any secret in this file.
# Anything prefixed VITE_ is inlined into the public JavaScript bundle and
# is readable by anyone who loads the page. The database is reached only
# through the backend API; the connection string stays in Backend/.env on
# the server.
