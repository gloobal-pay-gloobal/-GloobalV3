# Copy this file to ".env" (same folder) and fill in real values.
# report-mailer/.env is gitignored — never commit real credentials.

# --- Gmail SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gloobalpay@gmail.com
# NOT your normal Gmail password. Create a Google "App Password":
#   Google Account -> Security -> 2-Step Verification (must be ON)
#   -> App passwords -> generate one -> paste the 16 chars here (no spaces).
SMTP_PASS=your-16-char-app-password

# --- How the email looks to recipients ---
# A real human name here (not "no-reply") helps deliverability a lot.
FROM_NAME=Aditya Raj — Gloobal
FROM_EMAIL=gloobalpay@gmail.com
REPLY_TO=gloobalpay@gmail.com

# --- Default recipients if you don't pass --to on the command line ---
# Comma-separated.
DEFAULT_RECIPIENTS=someone@example.com
