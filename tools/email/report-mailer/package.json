{
  "name": "gloobal-report-mailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sends Gloobal progress and project reports over email on demand.",
  "scripts": {
    "send": "node send-report.mjs",
    "progress": "node send-report.mjs --report=progress",
    "project": "node send-report.mjs --report=project",
    "both": "node send-report.mjs --report=both"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "marked": "^12.0.2",
    "nodemailer": "^6.9.14"
  }
}
